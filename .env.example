# ---- AWS / Bedrock -----------------------------------------------------
# Jamais de clés en dur : soit un profil AWS local (recommandé en dev),
# soit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# injectés par un gestionnaire de secrets en prod.
AWS_REGION=us-west-2
AWS_PROFILE=default

# Modèle de génération (SQL, Python, rapports). ID d'inference profile Bedrock.
# claude-sonnet-5 n'est pas encore activé sur tous les comptes -> fallback sonnet-4-5.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_RETRIES=5
BEDROCK_TIMEOUT_SECONDS=60

# ---- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=northwind
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=change_me
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin
# Rôle lecture seule utilisé par l'agent pour exécuter le SQL généré (Phase 1)
POSTGRES_READONLY_USER=agent_readonly
POSTGRES_READONLY_PASSWORD=change_me_readonly

# ---- Qdrant ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=schema_index

# ---- MinIO (S3-compatible) ------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET_LANGFUSE=langfuse
MINIO_SECURE=false

# ---- Redis (Celery + cache) -----------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Langfuse (observabilité, self-hosted) --------------------------------
LANGFUSE_HOST=http://localhost:3001
# Générés après le premier démarrage, via l'UI Langfuse (Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Secrets internes Langfuse (générer avec: openssl rand -hex 32)
LANGFUSE_SALT=change_me_generate_with_openssl_rand_hex_32
LANGFUSE_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32
LANGFUSE_NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_hex_32
CLICKHOUSE_PASSWORD=change_me_clickhouse
# Bootstrap automatique (org/projet/utilisateur/clé API) au premier démarrage
# -> évite l'inscription manuelle via l'UI. Générer les clés avec:
#   python3 -c "import secrets; print('pk-lf-'+secrets.token_hex(16)); print('sk-lf-'+secrets.token_hex(16))"
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=Hybrid Data Analyst
LANGFUSE_INIT_PROJECT_ID=default-project
LANGFUSE_INIT_PROJECT_NAME=agent-data-analyst
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change_me_pk_lf
LANGFUSE_INIT_PROJECT_SECRET_KEY=change_me_sk_lf
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change_me_admin_ui_password

# ---- Sources de données -----------------------------------------------
FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
NORTHWIND_SQL_URL=https://raw.githubusercontent.com/pthom/northwind_psql/master/northwind.sql
ONLINE_RETAIL_XLSX_URL=https://archive.ics.uci.edu/static/public/502/online+retail+ii.zip
# Nécessite un kaggle.json valide (~/.kaggle/kaggle.json) pour le téléchargement
KAGGLE_DATASET=kritanjalijain/amazon-reviews

# ---- Sandbox d'exécution Python (Phase 2) ------------------------------
# Construire l'image avant utilisation: docker build -t hybrid-data-analyst-sandbox:latest sandbox/
SANDBOX_IMAGE=hybrid-data-analyst-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_CHART_TIMEOUT_SECONDS=45

# ---- Divers -----------------------------------------------------------
LOG_LEVEL=INFO
